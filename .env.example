# MaaganM Cars local API configuration

# Upstream booking service base URL.
CARS_BASE_URL=https://sidur.maaganm.co.il

# Optional static Bearer token accepted by the local API.
CARS_API_TOKEN=

# Local upstream account codes. Keep real values in .env.local, never in git.
CARS_PERSONAL_CODE=
# Set this only after the real work code is provided; do not use a placeholder.
CARS_WORK_CODE=

# Max cached upstream sessions for caller-supplied member codes (default 16).
CARS_MAX_MEMBER_SESSIONS=

# Signing settings for locally generated JWTs.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Local server binding.
HOST=127.0.0.1
PORT=8002
REQUEST_TIMEOUT=30.0

# Gmail command-bus identity and delivery settings.
# No built-in defaults: set real addresses only in .env.local.
GMAIL_COMMAND_ALIAS=
GMAIL_ALLOWED_SENDER=
GMAIL_RESULT_RECIPIENT=

# Required signing secret; keep it only in local environment configuration.
GMAIL_HMAC_SECRET=

# Persistent command-bus state database path; leave blank to use the project default.
GMAIL_STATE_DB_PATH=

# Gmail label applied to processed messages (default: Agents).
GMAIL_PROCESSED_LABEL=

# Polling interval and Gmail operation timeout have safe defaults.
GMAIL_POLL_INTERVAL=
GAPI_EXECUTABLE=
GAPI_TIMEOUT=

# Authorized-user OAuth JSON used for Gmail message discovery.
GMAIL_CREDENTIALS_FILE=
